# LLM Gateway Environment Configuration
# Copy this file to .env and configure with your actual credentials.

# API Keys (Loaded strictly from environment, NEVER hardcoded or stored in config.yaml)
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GROQ_API_KEY=your-groq-api-key-here

# Database Configuration (PostgreSQL in production/Docker, SQLite supported for tests)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/llm_gateway
# For Docker Compose, the host is 'postgres':
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/llm_gateway

# Redis Configuration (Must use Redis Stack for RediSearch vector indexing)
REDIS_URL=redis://localhost:6379/0
# For Docker Compose, the host is 'redis':
# REDIS_URL=redis://redis:6379/0

# Application Configuration
APP_ENV=production
CONFIG_PATH=config.yaml
LOG_LEVEL=INFO
PORT=8000
HOST=0.0.0.0
